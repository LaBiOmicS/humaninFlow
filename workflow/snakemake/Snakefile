# ==============================================================================
# humaninFlow · Snakemake implementation
# Data-agnostic discovery of Humanin and SHLP1-6 with HumaninFinder
#
#   snakemake -s workflow/snakemake/Snakefile --cores 4                 # example data
#   snakemake -s workflow/snakemake/Snakefile --cores 4 \
#       --config input_fasta=my.fasta metadata=meta.csv outdir=results/run1
#   ... --use-conda | --use-apptainer                                   # managed software
# ==============================================================================

import os
import re

# Defaults ship next to this Snakefile, so it works from any working directory.
configfile: os.path.join(workflow.basedir, "config", "config.yaml")

INPUT_FASTA = config["input_fasta"]
METADATA    = config.get("metadata") or ""
OUTDIR      = config["outdir"]
COMMAND     = config.get("command", "predict")
BIN         = config.get("humanin_finder_bin", "humanin-finder")

if COMMAND not in ("predict", "scan"):
    raise ValueError(f"config 'command' must be 'predict' or 'scan', got {COMMAND!r}")
if METADATA and not os.path.exists(METADATA):
    raise FileNotFoundError(f"metadata file not found: {METADATA}")

flags = []
if config.get("table"):
    flags.append(f"-g {config['table']}")
if config.get("circular", True):
    flags.append("--circular")
if config.get("all_candidates", False) and COMMAND == "predict":
    flags.append("--all-candidates")
for key, flag in (("no_hmm", "--no-hmm"), ("no_rescue", "--no-rescue"),
                  ("no_shlp", "--no-shlp"), ("no_synteny", "--no-synteny")):
    if config.get(key, False):
        flags.append(flag)
CLI_FLAGS = " ".join(flags)

# Same prefix rule as the Nextflow implementation: strip .fa/.fasta/.fna/.fas and an optional .gz
PREFIX = re.sub(r"\.(fa|fasta|fna|fas)(\.gz)?$", "", os.path.basename(INPUT_FASTA))

ENV       = os.path.join(workflow.basedir, "..", "envs", "humaninfinder.yaml")
CONTAINER = "docker://ghcr.io/labiomics/humaninfinder:1.0.0b5"
SUMMARIZE = os.path.join(workflow.basedir, "..", "scripts", "merge_and_report.py")

RAW = os.path.join(OUTDIR, "raw_predictions")
SUM = os.path.join(OUTDIR, "summary")


rule all:
    input:
        os.path.join(SUM, "cohort_humanin_summary.csv"),
        os.path.join(SUM, "cohort_humanin_summary.tsv"),
        os.path.join(SUM, "cohort_unique_peptides.fasta"),
        os.path.join(SUM, "COHORT_ANALYSIS_REPORT.md"),


rule lint:
    input:
        fasta = INPUT_FASTA,
    output:
        touch(os.path.join(OUTDIR, "lint", f"{PREFIX}.lint.done")),
    log:
        os.path.join(OUTDIR, "logs", f"{PREFIX}.lint.log"),
    conda: ENV
    container: CONTAINER
    shell:
        '{BIN} lint "{input.fasta}" > {log} 2>&1'


rule predict:
    input:
        fasta = INPUT_FASTA,
        lint  = rules.lint.output,
    output:
        csv   = os.path.join(RAW, f"{PREFIX}_results.csv"),
        fasta = os.path.join(RAW, f"{PREFIX}_results.fasta"),
        gff3  = os.path.join(RAW, f"{PREFIX}_results.gff3"),
        bed   = os.path.join(RAW, f"{PREFIX}_results.bed"),
        json  = os.path.join(RAW, f"{PREFIX}_run.json"),
    params:
        prefix = os.path.join(RAW, PREFIX),
        flags  = CLI_FLAGS,
    log:
        os.path.join(OUTDIR, "logs", f"{PREFIX}.{COMMAND}.log"),
    threads: int(config.get("threads", 4))
    conda: ENV
    container: CONTAINER
    shell:
        '{BIN} {COMMAND} -i "{input.fasta}" -o "{params.prefix}" --threads {threads} {params.flags} > {log} 2>&1'


rule summarize:
    input:
        csv    = rules.predict.output.csv,
        script = SUMMARIZE,
    output:
        csv      = os.path.join(SUM, "cohort_humanin_summary.csv"),
        tsv      = os.path.join(SUM, "cohort_humanin_summary.tsv"),
        peptides = os.path.join(SUM, "cohort_unique_peptides.fasta"),
        report   = os.path.join(SUM, "COHORT_ANALYSIS_REPORT.md"),
    params:
        meta = f'--metadata "{METADATA}"' if METADATA else "",
    log:
        os.path.join(OUTDIR, "logs", "summarize.log"),
    conda: ENV
    container: CONTAINER
    shell:
        """
        python3 "{input.script}" --results-csv "{input.csv}" {params.meta} \
            --out-csv "{output.csv}" --out-tsv "{output.tsv}" \
            --out-peptides "{output.peptides}" --out-report "{output.report}" > {log} 2>&1
        """
