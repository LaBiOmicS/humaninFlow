/*
========================================================================================
   Nextflow Configuration for humaninFlow
   Agnostic & Reproducible MDP (Humanin/SHLP) Prediction Pipeline
   Laboratory of Bioinformatics and Omics Sciences (LaBiOmicS)
========================================================================================
*/

params {
    // Inputs (Defaults point to generic example dataset, override via CLI --input and --metadata)
    input             = "${projectDir}/../../examples/test_mitogenomes.fasta"
    metadata          = "${projectDir}/../../examples/test_metadata.csv"
    outdir            = "results/nextflow"
    help              = false

    // HumaninFinder Parameters
    command           = 'predict'      // 'predict' or 'scan'
    table             = 'auto'         // 'auto', '2', '2,1', etc.
    circular          = true           // true for mitogenomes <= 50kb
    all_candidates    = false          // report all non-redundant candidates
    no_hmm            = false          // skip PF15040 HMM search
    no_rescue         = false          // skip HMM-guided frame rescue
    no_shlp           = false          // skip SHLP1-6 annotation
    no_synteny        = false          // skip MT-RNR2 synteny search

    // Execution / Performance
    split_chunks      = 0              // 0 = process as single file; >0 = split multi-FASTA into N sequences per parallel worker
    max_memory        = '16.GB'
    max_cpus          = 8
    max_time          = '4.h'
}

// Default execution environment
process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    cpus   = { 2 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    local {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled       = true
        docker.userEmulation = true
        process.container    = 'ghcr.io/labiomics/humaninfinder:v1.0.0b4'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://ghcr.io/labiomics/humaninfinder:v1.0.0b4'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = 'docker://ghcr.io/labiomics/humaninfinder:v1.0.0b4'
    }
}
