/*
========================================================================================
   Nextflow Configuration for humaninFlow
   Agnostic & Reproducible MDP (Humanin/SHLP) Prediction Pipeline
   Laboratory of Bioinformatics and Omics Sciences (LaBiOmicS)
========================================================================================
*/

params {
    // Inputs (required; use -profile test for the bundled example data)
    input             = null
    metadata          = null
    outdir            = "results/nextflow"
    help              = false

    // HumaninFinder Parameters
    command           = 'predict'      // 'predict' or 'scan'
    table             = 'auto'         // 'auto', '2', '2,1', etc.
    circular          = true           // true for mitogenomes <= 50kb
    all_candidates    = false          // report all non-redundant candidates
    no_hmm            = false          // skip PF15040 HMM search
    no_rescue         = false          // skip HMM-guided frame rescue
    no_shlp           = false          // skip SHLP1-6 annotation
    no_synteny        = false          // skip MT-RNR2 synteny search
}

// Default execution environment
process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    cpus   = { 2 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    // Caps every request (including retries); override with -process.resourceLimits
    resourceLimits = [cpus: 8, memory: 16.GB, time: 4.h]

    errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.input    = "${projectDir}/../../examples/test_mitogenomes.fasta"
        params.metadata = "${projectDir}/../../examples/test_metadata.csv"
        params.table    = '2'
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/../envs/humaninfinder.yaml"
    }

    docker {
        docker.enabled       = true
        // The image's ENTRYPOINT is humanin-finder; clear it so Nextflow can run bash
        docker.runOptions    = '-u $(id -u):$(id -g) --entrypoint ""'
        process.container    = 'ghcr.io/labiomics/humaninfinder:1.0.0b5'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://ghcr.io/labiomics/humaninfinder:1.0.0b5'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = 'docker://ghcr.io/labiomics/humaninfinder:1.0.0b5'
    }
}
